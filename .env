# Use mock data for development (set to 'false' to use real n8n webhook)
VITE_USE_MOCK_DATA=false

# Show React Query DevTools (set to 'false' to hide in production)
VITE_SHOW_DEVTOOLS=false

# Directus backend URL (nginx proxy)
VITE_DIRECTUS_URL=http://localhost:8080

# n8n webhook URL (nginx proxy)
VITE_N8N_WEBHOOK_URL=http://localhost:8081/webhook/chat
