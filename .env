# Use mock data for development (set to 'false' to use real n8n webhook)
VITE_USE_MOCK_DATA=false

# Show React Query DevTools (set to 'false' to hide in production)
VITE_SHOW_DEVTOOLS=false

# Directus backend URL (nginx proxy)
VITE_DIRECTUS_URL=

# n8n webhook URL (nginx proxy)
VITE_N8N_WEBHOOK_URL=

# Portainer API configuration (nginx proxy)
# Get API token from: Portainer UI → Settings → Users → [Your user] → Add access token
# Find endpoint ID from: Portainer UI → Endpoints → [Your endpoint] (usually '2' for local Docker)
VITE_PORTAINER_URL=
VITE_PORTAINER_TOKEN=
VITE_PORTAINER_ENDPOINT_ID=
